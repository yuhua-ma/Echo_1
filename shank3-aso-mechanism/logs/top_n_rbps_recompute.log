function (cols, status = "unavailable", warning = "") 
{
    df <- as.data.frame(matrix(nrow = 0, ncol = length(cols)))
    names(df) <- cols
    if ("status" %in% cols) {
    }
    attr(df, "status") <- status
    attr(df, "warning") <- warning
    df
}

